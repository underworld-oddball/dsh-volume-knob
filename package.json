{
  "name": "sh-volume-shuff",
  "version": "0.1.2",
  "description": "Read the newest turn aloud from the DSH composer: a speaker button in the composer tool row, left of the model selector, that reads from the start of your newest question, scrolls the page to that spot and marks it with a blinking caret on one click, stops on the next, press-and-hold the icon to pick any other reading start position on the page, and opens a vertical volume mixer (in-page media volume + system output) on press-and-drag-up.",
  "license": "MIT",
  "author": "江湖老妖",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "volume",
    "tts",
    "read-aloud",
    "accessibility"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.5-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underworld-oddball/sh-volume-shuff.git"
  },
  "homepage": "https://github.com/underworld-oddball/sh-volume-shuff#readme",
  "bugs": {
    "url": "https://github.com/underworld-oddball/sh-volume-shuff/issues"
  }
}
